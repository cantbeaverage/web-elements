# You must add functionability yourself!

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Optical Search | Glassmorphic UI</title>
    <style>
        :root {
            --glass-bg: rgba(255, 255, 255, 0.03);
            --glass-border: rgba(255, 255, 255, 0.12);
            --glass-shine: rgba(255, 255, 255, 0.25);
            --accent: #38bdf8;
            --accent-glow: rgba(56, 189, 248, 0.35);
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
            --mouse-x: 50%;
            --mouse-y: 50%;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            height: 100vh;
            background-color: #030712;
            display: flex;
            justify-content: center;
            align-items: center;
            font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
            overflow: hidden;
            color: var(--text-main);
        }

        /* Ambient Refraction Background */
        .bg-refraction {
            position: absolute;
            inset: -20%;
            background: 
                radial-gradient(circle at 20% 30%, rgba(56, 189, 248, 0.25) 0%, transparent 40%),
                radial-gradient(circle at 80% 70%, rgba(139, 92, 246, 0.25) 0%, transparent 40%),
                radial-gradient(circle at 50% 50%, rgba(236, 72, 153, 0.15) 0%, transparent 50%);
            filter: blur(80px);
            z-index: 0;
            pointer-events: none;
            animation: pulse-bg 12s ease-in-out infinite alternate;
        }

        @keyframes pulse-bg {
            0% { transform: scale(1) rotate(0deg); }
            100% { transform: scale(1.08) rotate(3deg); }
        }

        .scene {
            perspective: 1200px;
            width: 100%;
            max-width: 680px;
            padding: 20px;
            z-index: 1;
        }

        .search-slab {
            position: relative;
            width: 100%;
            display: flex;
            align-items: center;
            padding: 16px 24px;
            background: var(--glass-bg);
            backdrop-filter: blur(24px) saturate(180%);
            -webkit-backdrop-filter: blur(24px) saturate(180%);
            border-radius: 9999px;
            border: 1px solid var(--glass-border);
            transform-style: preserve-3d;
            box-shadow: 
                0 30px 60px -12px rgba(0, 0, 0, 0.5),
                0 18px 36px -18px rgba(0, 0, 0, 0.7),
                inset 0 1px 1px var(--glass-shine);
            transition: border-color 0.3s ease, box-shadow 0.3s ease;
        }

        /* Mouse Tracking Highlight */
        .search-slab::after {
            content: '';
            position: absolute;
            inset: 0;
            border-radius: inherit;
            background: radial-gradient(
                600px circle at var(--mouse-x) var(--mouse-y),
                rgba(255, 255, 255, 0.08),
                transparent 40%
            );
            pointer-events: none;
            z-index: 1;
        }

        .search-icon {
            width: 22px;
            height: 22px;
            stroke: var(--text-muted);
            margin-right: 16px;
            transform: translateZ(20px);
            transition: stroke 0.3s ease, filter 0.3s ease;
            flex-shrink: 0;
        }

        .search-input {
            width: 100%;
            background: transparent;
            border: none;
            outline: none;
            color: var(--text-main);
            font-size: 1.125rem;
            font-weight: 400;
            letter-spacing: -0.01em;
            transform: translateZ(25px);
            z-index: 2;
        }

        .search-input::placeholder {
            color: var(--text-muted);
            opacity: 0.7;
        }

        /* Shortcut Badge */
        .shortcut-badge {
            display: flex;
            align-items: center;
            gap: 4px;
            padding: 4px 8px;
            background: rgba(255, 255, 255, 0.06);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 6px;
            color: var(--text-muted);
            font-size: 0.75rem;
            font-weight: 500;
            transform: translateZ(20px);
            white-space: nowrap;
            user-select: none;
            transition: opacity 0.2s ease;
        }

        /* Clear Button */
        .clear-btn {
            background: none;
            border: none;
            color: var(--text-muted);
            cursor: pointer;
            padding: 4px;
            display: none;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            transform: translateZ(20px);
            transition: color 0.2s ease, background 0.2s ease;
            z-index: 2;
        }

        .clear-btn:hover {
            color: var(--text-main);
            background: rgba(255, 255, 255, 0.1);
        }

        /* Focus & Interactive States */
        .search-slab:focus-within {
            border-color: rgba(56, 189, 248, 0.4);
            box-shadow: 
                0 30px 60px -12px rgba(0, 0, 0, 0.6),
                0 0 20px var(--accent-glow),
                inset 0 1px 1px var(--glass-shine);
        }

        .search-slab:focus-within .search-icon {
            stroke: var(--accent);
            filter: drop-shadow(0 0 8px var(--accent-glow));
        }

        @media (max-width: 640px) {
            .shortcut-badge {
                display: none;
            }
            .search-slab {
                padding: 14px 20px;
            }
        }
    </style>
</head>
<body>

    <div class="bg-refraction"></div>

    <main class="scene">
        <div class="search-slab" id="searchSlab">
            <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            
            <input type="text" class="search-input" id="searchInput" placeholder="Search resources, documents, or commands..." spellcheck="false" autocomplete="off">
            
            <button class="clear-btn" id="clearBtn" aria-label="Clear search">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>

            <div class="shortcut-badge" id="shortcutBadge">
                <span>⌘</span><span>K</span>
            </div>
        </div>
    </main>

    <script>
        const slab = document.getElementById('searchSlab');
        const input = document.getElementById('searchInput');
        const clearBtn = document.getElementById('clearBtn');
        const badge = document.getElementById('shortcutBadge');

        // Target and Current values for smooth lerp physics
        let targetX = 0, targetY = 0;
        let currentX = 0, currentY = 0;
        let isHovered = false;

        // Smooth Lerp Function
        function lerp(start, end, factor) {
            return start + (end - start) * factor;
        }

        // Animation Loop for 60fps smoothing
        function animate() {
            if (isHovered) {
                currentX = lerp(currentX, targetX, 0.1);
                currentY = lerp(currentY, targetY, 0.1);
            } else {
                currentX = lerp(currentX, 0, 0.08);
                currentY = lerp(currentY, 0, 0.08);
            }

            slab.style.transform = `rotateX(${currentY}deg) rotateY(${currentX}deg)`;
            requestAnimationFrame(animate);
        }
        animate();

        // Mouse Motion Tracking
        window.addEventListener('mousemove', (e) => {
            const rect = slab.getBoundingClientRect();
            
            // Mouse coords relative to slab center
            const centerX = rect.left + rect.width / 2;
            const centerY = rect.top + rect.height / 2;
            
            // Spotlight positioning relative to element
            const lx = e.clientX - rect.left;
            const ly = e.clientY - rect.top;
            slab.style.setProperty('--mouse-x', `${lx}px`);
            slab.style.setProperty('--mouse-y', `${ly}px`);

            // Tilt Calculations
            const distanceX = e.clientX - centerX;
            const distanceY = e.clientY - centerY;

            // Constrain maximum rotation angle
            targetX = Math.max(-12, Math.min(12, distanceX / 25));
            targetY = Math.max(-12, Math.min(12, -distanceY / 15));
            
            isHovered = true;
        });

        window.addEventListener('mouseleave', () => {
            isHovered = false;
        });

        // Search Input Functionality
        input.addEventListener('input', () => {
            if (input.value.length > 0) {
                clearBtn.style.display = 'flex';
                badge.style.opacity = '0';
            } else {
                clearBtn.style.display = 'none';
                badge.style.opacity = '1';
            }
        });

        clearBtn.addEventListener('click', () => {
            input.value = '';
            input.focus();
            clearBtn.style.display = 'none';
            badge.style.opacity = '1';
        });

        // Global Keyboard Shortcuts (Cmd/Ctrl + K or '/')
        window.addEventListener('keydown', (e) => {
            if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
                e.preventDefault();
                input.focus();
            } else if (e.key === '/' && document.activeElement !== input) {
                e.preventDefault();
                input.focus();
            } else if (e.key === 'Escape' && document.activeElement === input) {
                input.blur();
            }
        });

        // Adjust badge icon according to OS
        if (navigator.platform.indexOf('Mac') === -1) {
            badge.innerHTML = '<span>Ctrl</span><span>K</span>';
        }
    </script>
</body>
</html>
