<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Prismatic Glass Search</title>
    <style>
        :root {
            --bg-dark: #030a08;
            --emerald-glow: rgba(16, 185, 129, 0.2);
            --gold-accent: #fbbf24;
            --gold-glow: rgba(251, 191, 36, 0.4);
            --glass-bg: rgba(6, 24, 18, 0.45);
            --mouse-x: 50%;
            --mouse-y: 50%;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            height: 100vh;
            background: var(--bg-dark);
            display: flex;
            justify-content: center;
            align-items: center;
            font-family: 'Cinzel', system-ui, -apple-system, sans-serif;
            overflow: hidden;
        }

        /* Deep Cosmic Nebula Background */
        .nebula {
            position: absolute;
            inset: 0;
            background: 
                radial-gradient(circle at 30% 20%, rgba(6, 95, 70, 0.35) 0%, transparent 50%),
                radial-gradient(circle at 70% 80%, rgba(180, 83, 9, 0.2) 0%, transparent 50%),
                radial-gradient(circle at 50% 50%, rgba(4, 47, 46, 0.5) 0%, transparent 70%);
            filter: blur(90px);
            z-index: 0;
            pointer-events: none;
        }

        .scene {
            perspective: 1000px;
            width: 100%;
            max-width: 680px;
            padding: 24px;
            z-index: 1;
        }

        /* Faceted Glass Slab */
        .prism-slab {
            position: relative;
            width: 100%;
            display: flex;
            align-items: center;
            padding: 18px 28px;
            background: var(--glass-bg);
            backdrop-filter: blur(30px) saturate(220%);
            -webkit-backdrop-filter: blur(30px) saturate(220%);
            border-radius: 100px;
            border: 1px solid rgba(251, 191, 36, 0.2);
            box-shadow: 
                0 30px 70px rgba(0, 0, 0, 0.8),
                inset 0 0 15px rgba(16, 185, 129, 0.15),
                inset 0 1px 2px rgba(255, 255, 255, 0.3);
            transform-style: preserve-3d;
            transition: border-color 0.4s ease, box-shadow 0.4s ease;
            overflow: hidden;
        }

        /* Prismatic Rainbow Light Sweep */
        .prism-slab::before {
            content: '';
            position: absolute;
            inset: -100%;
            background: conic-gradient(
                from 0deg at var(--mouse-x) var(--mouse-y),
                transparent 0deg,
                rgba(239, 68, 68, 0.15) 60deg,
                rgba(245, 158, 11, 0.15) 120deg,
                rgba(16, 185, 129, 0.15) 180deg,
                rgba(59, 130, 246, 0.15) 240deg,
                rgba(168, 85, 247, 0.15) 300deg,
                transparent 360deg
            );
            pointer-events: none;
            mix-blend-mode: color-dodge;
            opacity: 0.7;
            transition: opacity 0.3s ease;
        }

        /* Specular Edge Highlight */
        .prism-slab::after {
            content: '';
            position: absolute;
            inset: 0;
            border-radius: inherit;
            padding: 1.5px;
            background: linear-gradient(
                135deg, 
                rgba(251, 191, 36, 0.6) 0%, 
                transparent 40%, 
                rgba(16, 185, 129, 0.4) 100%
            );
            -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
            mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
            -webkit-mask-composite: xor;
            mask-composite: exclude;
            pointer-events: none;
        }

        .search-icon {
            width: 24px;
            height: 24px;
            stroke: var(--gold-accent);
            margin-right: 18px;
            transform: translateZ(25px);
            filter: drop-shadow(0 0 6px var(--gold-glow));
            transition: transform 0.3s ease, filter 0.3s ease;
            flex-shrink: 0;
        }

        .search-input {
            width: 100%;
            background: transparent;
            border: none;
            outline: none;
            color: #fef3c7;
            font-size: 1.15rem;
            letter-spacing: 0.05em;
            transform: translateZ(30px);
            z-index: 2;
        }

        .search-input::placeholder {
            color: rgba(251, 191, 36, 0.4);
            font-style: italic;
        }

        /* Focus & Interactive States */
        .prism-slab:focus-within {
            border-color: rgba(251, 191, 36, 0.6);
            box-shadow: 
                0 40px 90px rgba(0, 0, 0, 0.9),
                0 0 30px var(--gold-glow),
                inset 0 0 20px rgba(16, 185, 129, 0.25);
        }

        .prism-slab:focus-within .search-icon {
            transform: translateZ(25px) scale(1.15) rotate(-5deg);
            filter: drop-shadow(0 0 12px var(--gold-accent));
        }

        /* Minimal Crystal Clear Button */
        .clear-btn {
            background: rgba(251, 191, 36, 0.1);
            border: 1px solid rgba(251, 191, 36, 0.3);
            color: var(--gold-accent);
            cursor: pointer;
            width: 26px;
            height: 26px;
            display: none;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            transform: translateZ(25px);
            transition: all 0.2s ease;
            z-index: 2;
        }

        .clear-btn:hover {
            background: var(--gold-accent);
            color: var(--bg-dark);
            box-shadow: 0 0 10px var(--gold-glow);
        }
    </style>
</head>
<body>

    <div class="nebula"></div>

    <main class="scene">
        <div class="prism-slab" id="prismSlab">
            <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>

            <input type="text" class="search-input" id="searchInput" placeholder="Search . . ." spellcheck="false" autocomplete="off">

            <button class="clear-btn" id="clearBtn" aria-label="Clear">✕</button>
        </div>
    </main>

    <script>
        const slab = document.getElementById('prismSlab');
        const input = document.getElementById('searchInput');
        const clearBtn = document.getElementById('clearBtn');

        let targetX = 0, targetY = 0;
        let currentX = 0, currentY = 0;
        let isHovered = false;

        function lerp(start, end, factor) {
            return start + (end - start) * factor;
        }

        // 60FPS Physics Engine
        function animate() {
            if (isHovered) {
                currentX = lerp(currentX, targetX, 0.08);
                currentY = lerp(currentY, targetY, 0.08);
            } else {
                currentX = lerp(currentX, 0, 0.05);
                currentY = lerp(currentY, 0, 0.05);
            }

            slab.style.transform = `rotateX(${currentY}deg) rotateY(${currentX}deg)`;
            requestAnimationFrame(animate);
        }
        animate();

        // Mouse Motion & Prismatic Tracking
        window.addEventListener('mousemove', (e) => {
            const rect = slab.getBoundingClientRect();
            
            const lx = e.clientX - rect.left;
            const ly = e.clientY - rect.top;
            slab.style.setProperty('--mouse-x', `${lx}px`);
            slab.style.setProperty('--mouse-y', `${ly}px`);

            const centerX = rect.left + rect.width / 2;
            const centerY = rect.top + rect.height / 2;

            targetX = Math.max(-10, Math.min(10, (e.clientX - centerX) / 20));
            targetY = Math.max(-10, Math.min(10, (centerY - e.clientY) / 12));

            isHovered = true;
        });

        window.addEventListener('mouseleave', () => {
            isHovered = false;
        });

        // Clear functionality
        input.addEventListener('input', () => {
            clearBtn.style.display = input.value.length > 0 ? 'flex' : 'none';
        });

        clearBtn.addEventListener('click', () => {
            input.value = '';
            input.focus();
            clearBtn.style.display = 'none';
        });
    </script>
</body>
</html>
